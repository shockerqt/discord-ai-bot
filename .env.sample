APP_ID=<YOUR_APP_ID>
DISCORD_TOKEN=<YOUR_BOT_TOKEN>
PUBLIC_KEY=<YOUR_PUBLIC_KEY>
MISTRAL_API_KEY=<YOUR_MISTRAL_API_KEY>
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
KLIPY_API_KEY=

# Default debug mode for all channels (off|thoughts|full) - useful for local dev
DEFAULT_DEBUG_MODE=full

# Gemini: default chat provider
GOOGLE_API_KEY=

# Gemini key used by the YouTube video summarizer (services/media/mediaProcessor.js)
GEMINI_API_KEY=

# Dashboard security (Basic Auth password, username is 'admin')
DASHBOARD_PASSWORD=
