[Unit]
Description=Lumi Discord bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/lumi-bot
Environment=NODE_ENV=production
EnvironmentFile=/opt/lumi-bot/.env
ExecStart=/opt/lumi-bot/runtime/node /opt/lumi-bot/app.js
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/lumi-bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lumi-bot

[Install]
WantedBy=multi-user.target
